{
  "name": "visionctx",
  "version": "0.1.0",
  "description": "Visual context compression and observability for AI coding agents",
  "type": "module",
  "private": true,
  "bin": { "visionctx": "./dist/apps/cli/index.js" },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/apps/cli/index.js start",
    "dev": "node --experimental-strip-types apps/cli/index.ts start"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.81",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
